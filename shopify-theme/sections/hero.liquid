{%- comment -%}
  Hero: WebGL image sequence (three portrait shots per slide on desktop,
  one on phones), brush-wipe logo, headline and CTAs.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
-%}
<section class="hero" id="top" data-hero {{ section.shopify_attributes }}>
  <div class="hero__media">
    {%- capture wide -%}
      [{%- for block in section.blocks -%}
        [{%- for i in (1..3) -%}
          {%- assign key = 'image_' | append: i -%}
          {%- assign fb = 'fallback_' | append: i -%}
          {%- if block.settings[key] != blank -%}"{{ block.settings[key] | image_url: width: 1400 }}"{%- else -%}"{{ block.settings[fb] | asset_url }}"{%- endif -%}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}]
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}]
    {%- endcapture -%}
    <canvas class="hero__gl" data-hero-gl aria-hidden="true" data-slides-wide="{{ wide | strip_newlines | escape }}"></canvas>
    <div class="hero__fallback" data-hero-fallback>
      {%- for block in section.blocks -%}
        {%- if block.settings.image_1 != blank -%}
          {%- assign src = block.settings.image_1 | image_url: width: 1400 -%}
          {%- assign src_w = block.settings.image_1.width -%}
          {%- assign src_h = block.settings.image_1.height -%}
        {%- else -%}
          {%- assign src = block.settings.fallback_1 | asset_url -%}
          {%- capture fb_size -%}{%- render 'asset-size', file: block.settings.fallback_1 -%}{%- endcapture -%}
          {%- assign fb_size = fb_size | strip | split: ' ' -%}
          {%- assign src_w = fb_size[0] -%}
          {%- assign src_h = fb_size[1] -%}
        {%- endif -%}
        <img data-photo data-hero-slide src="{{ src }}" alt="{{ block.settings.alt | escape }}" width="{{ src_w }}" height="{{ src_h }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} {{ block.shopify_attributes }}>
      {%- endfor -%}
    </div>
    <div class="hero__shade"></div>
  </div>

  <div class="hero__content">
    <h1 class="hero__title display" data-hero-title>
      <span class="line"><span>{{ section.settings.heading_1 | escape }}</span></span>
      {%- if section.settings.heading_2 != blank -%}<span class="line"><span>{{ section.settings.heading_2 | escape }}</span></span>{%- endif -%}
    </h1>
    <div class="hero__aside" data-hero-aside>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="hero__ctas">
        {%- if section.settings.button_1_label != blank -%}<a class="btn btn--solid" href="{{ section.settings.button_1_link | default: '#drop' }}">{{ section.settings.button_1_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.button_2_link | default: '#collection' }}">{{ section.settings.button_2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>

  <p class="hero__note" data-hero-note hidden></p>

  {%- if slide_count > 1 -%}
    <div class="hero__progress" aria-hidden="true" data-hero-progress>
      {%- for block in section.blocks -%}<span class="hero__tick"><i></i></span>{%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_logo -%}
    <div class="hero__logo" data-hero-logo aria-hidden="true">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 2000 | image_tag: alt: '', width: 1300, height: 662 }}
      {%- else -%}
        <img src="{{ 'vyro-logo.png' | asset_url }}" alt="" width="1300" height="662">
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Built" },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "under load." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drop 01 is here. Hoodies, joggers, tees, tanks and shorts in black, navy and gray, cut for lifters who show up every day." },
    { "type": "text", "id": "button_1_label", "label": "First button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_1_link", "label": "First button link", "info": "Leave empty to scroll to the Drop 01 section." },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "See the colorways" },
    { "type": "url", "id": "button_2_link", "label": "Second button link", "info": "Leave empty to scroll to the product rail." },
    { "type": "checkbox", "id": "show_logo", "label": "Show large logo", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "paragraph", "content": "Desktop shows three portrait photos side by side. Phones show the first photo." },
        { "type": "image_picker", "id": "image_1", "label": "Photo 1 (also used on phones)" },
        { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
        { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
        { "type": "text", "id": "alt", "label": "Image description", "default": "VYRO Athletics in the gym" },
        { "type": "text", "id": "fallback_1", "label": "Bundled photo 1", "default": "life-1.jpg", "info": "Used when no photo is chosen." },
        { "type": "text", "id": "fallback_2", "label": "Bundled photo 2", "default": "life-4.jpg" },
        { "type": "text", "id": "fallback_3", "label": "Bundled photo 3", "default": "life-5.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide", "settings": { "fallback_1": "life-1.jpg", "fallback_2": "life-4.jpg", "fallback_3": "life-5.jpg" } },
        { "type": "slide", "settings": { "fallback_1": "life-7.jpg", "fallback_2": "life-2.jpg", "fallback_3": "life-8.jpg" } },
        { "type": "slide", "settings": { "fallback_1": "life-3.jpg", "fallback_2": "life-9.jpg", "fallback_3": "life-6.jpg" } }
      ]
    }
  ]
}
{% endschema %}
