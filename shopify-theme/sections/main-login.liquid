<div class="acct">
  <section class="acct__gate">
    <h1 class="acct__title display">{{ 'customer.account.title' | t }}</h1>
    <p class="acct__lede">{{ 'customer.login.lede' | t }}</p>
    <div class="auth" data-auth-root data-view="login">
      <div class="auth__tabs" role="tablist" aria-label="{{ 'customer.account.title' | t }}">
        <a role="tab" class="auth__tab" aria-selected="true" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
        <a role="tab" class="auth__tab" aria-selected="false" href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
      </div>

      {%- form 'customer_login', class: 'auth__form', data-form: 'login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="login-email">{{ 'customer.fields.email' | t }}</label><input id="login-email" type="email" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label for="login-password">{{ 'customer.fields.password' | t }}</label><input id="login-password" type="password" name="customer[password]" autocomplete="current-password" required></div>
        <button class="btn btn--solid auth__submit" type="submit">{{ 'customer.login.submit' | t }}</button>
        <a class="link-btn" href="#recover" data-auth-view="forgot">{{ 'customer.login.forgot' | t }}</a>
      {%- endform -%}

      {%- form 'recover_customer_password', class: 'auth__form', data-form: 'forgot', novalidate: 'novalidate' -%}
        <p class="auth__text">{{ 'customer.recover.text' | t }}</p>
        {%- if form.posted_successfully? -%}
          <p class="form__ok" role="status" data-recover-success>{{ 'customer.recover.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="recover-email">{{ 'customer.fields.email' | t }}</label><input id="recover-email" type="email" name="email" autocomplete="email" required></div>
        <button class="btn btn--solid auth__submit" type="submit">{{ 'customer.recover.submit' | t }}</button>
        <a class="link-btn" href="#login" data-auth-view="login">{{ 'customer.recover.back' | t }}</a>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        {%- form 'guest_login' -%}
          <button class="btn btn--ghost auth__submit" type="submit">{{ 'customer.login.guest' | t }}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{ "name": "Log in", "tag": "section", "settings": [] }
{% endschema %}
