<div class="cartpage" data-cart data-section="{{ section.id }}">
  <nav class="crumbs" aria-label="{{ 'general.breadcrumb' | t }}"><ol><li><a href="{{ routes.all_products_collection_url }}">{{ 'header.shop' | t }}</a></li><li aria-current="page">{{ 'cart.bag' | t }}</li></ol></nav>
  {%- if cart.item_count == 0 -%}
    <div class="empty empty--page">
      <h1 class="empty__title display">{{ 'cart.empty_title' | t }}</h1>
      <p>{{ 'cart.empty_text' | t }}</p>
      <a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_all' | t }}</a>
      {%- if shop.customer_accounts_enabled and customer == nil -%}
        <p>{{ 'cart.login_prompt_html' | t: url: routes.account_login_url }}</p>
      {%- endif -%}
    </div>
  {%- else -%}
    <h1 class="cartpage__title display">{{ 'cart.your_bag' | t }} <span>({{ cart.item_count }})</span></h1>
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cartpage__grid" novalidate>
      <section class="cartpage__lines" aria-label="{{ 'cart.items' | t }}">
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index -%}
        {%- endfor -%}
        <a class="link-btn cartpage__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </section>
      <aside class="summary" aria-label="{{ 'cart.summary' | t }}">
        <h2 class="summary__title display">{{ 'cart.summary' | t }}</h2>
        <div class="summary__rows">
          <div class="summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.items_subtotal_price | money_without_trailing_zeros }}</span></div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="summary__row"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span></div>
          {%- endfor -%}
          <div class="summary__row"><span>{{ 'cart.shipping' | t }}</span><span>{{ 'cart.shipping_at_checkout' | t }}</span></div>
          <div class="summary__row summary__row--total"><span>{{ 'cart.total' | t }}</span><strong>{{ cart.total_price | money_without_trailing_zeros }}</strong></div>
        </div>
        <div class="ship-meter">{%- render 'ship-meter' -%}</div>
        {%- if section.settings.show_note -%}
          <div class="field"><label for="cart-note">{{ 'cart.note' | t }}</label><textarea id="cart-note" name="note" rows="3" class="cart-note">{{ cart.note }}</textarea></div>
        {%- endif -%}
        <button type="submit" name="checkout" class="btn btn--solid summary__cta">{{ 'cart.checkout' | t }}</button>
        {%- if section.settings.note_text != blank -%}<p class="checkout__note">{{ section.settings.note_text | escape }}</p>{%- endif -%}
        {%- if additional_checkout_buttons and section.settings.show_express -%}
          <div class="cart__express">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "default": true },
    { "type": "text", "id": "note_text", "label": "Small print under checkout", "default": "Free shipping over €80. 30-day returns." }
  ]
}
{% endschema %}
