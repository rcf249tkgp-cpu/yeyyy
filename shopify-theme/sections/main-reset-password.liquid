<div class="acct">
  <section class="acct__gate">
    <h1 class="acct__title display">{{ 'customer.reset.title' | t }}</h1>
    <p class="acct__lede">{{ 'customer.reset.text' | t }}</p>
    {%- form 'reset_customer_password', class: 'auth__form acct__reset', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="reset-pw">{{ 'customer.fields.new_password' | t }}</label><input id="reset-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="reset-pw2">{{ 'customer.fields.confirm_password' | t }}</label><input id="reset-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--solid" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </section>
</div>

{% schema %}
{ "name": "Reset password", "tag": "section", "settings": [] }
{% endschema %}
