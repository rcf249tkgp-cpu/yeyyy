<article class="page-main">
  <p class="acct__hello">{{ article.published_at | date: format: 'date' }}</p>
  <h1 class="page-main__title display">{{ article.title | escape }}</h1>
  {%- if article.image -%}<div class="lookset__media page-main__image">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title }}</div>{%- endif -%}
  <div class="rte page-main__body">{{ article.content }}</div>
  <a class="btn btn--ghost" href="{{ blog.url }}">{{ 'blog.back' | t }}</a>
</article>

{% schema %}
{ "name": "Article", "tag": "section", "settings": [] }
{% endschema %}
