<div class="acct">
  <section class="acct__gate">
    <div class="intro__logo password__logo">
      {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 800 | image_tag: alt: shop.name }}{%- else -%}<img src="{{ 'vyro-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1300" height="662">{%- endif -%}
    </div>
    <h1 class="acct__title display">{{ section.settings.title | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="acct__lede">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="signup__msg is-ok" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="sr-only" for="pw-email">{{ 'newsletter.label' | t }}</label>
        <input class="signup__input" id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
        <button class="btn btn--solid signup__btn" type="submit">{{ 'newsletter.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details class="pdp__acc">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'auth__form acct__reset' -%}
        {%- if form.errors -%}<p class="form__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="store-pw">{{ 'customer.fields.password' | t }}</label><input id="store-pw" type="password" name="password" autocomplete="current-password"></div>
        <button class="btn btn--solid" type="submit">{{ 'password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </section>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Drop 01 is coming." } ]
}
{% endschema %}
