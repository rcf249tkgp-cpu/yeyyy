{%- comment -%} Slide-out bag. Re-rendered through the Section Rendering API after cart changes. {%- endcomment -%}
<div class="drawer" data-drawer data-cart-count="{{ cart.item_count }}" hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <section class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title" tabindex="-1" data-lenis-prevent>
    <header class="drawer__head">
      <h2 class="drawer__title display" id="drawer-title">{{ 'cart.your_bag' | t }} <span data-drawer-count>{% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span></h2>
      <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'cart.close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
    </header>
    <div class="ship-meter" data-ship>{%- render 'ship-meter' -%}</div>
    <div class="drawer__body" data-drawer-items>
      {%- for item in cart.items -%}
        {%- render 'cart-line', item: item, index: forloop.index -%}
      {%- else -%}
        <div class="empty">
          <p class="empty__title display">{{ 'cart.empty_title' | t }}</p>
          <p>{{ 'cart.empty_text' | t }}</p>
          <a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_all' | t }}</a>
        </div>
      {%- endfor -%}
    </div>
    {%- if cart.item_count > 0 -%}
      <footer class="drawer__foot" data-drawer-foot>
        <div class="drawer__row"><span>{{ 'cart.subtotal' | t }}</span><strong data-drawer-subtotal>{{ cart.total_price | money_without_trailing_zeros }}</strong></div>
        <p class="drawer__note">{{ 'cart.shipping_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post" class="drawer__ctas">
          <a class="btn btn--ghost" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
          <button type="submit" name="checkout" class="btn btn--solid">{{ 'cart.checkout' | t }}</button>
        </form>
      </footer>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
