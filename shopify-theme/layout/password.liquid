<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'vyro-logo.png' | asset_url }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" rel="stylesheet">
    {{ 'vyro.css' | asset_url | stylesheet_tag }}
    {{ 'vyro-shopify.css' | asset_url | stylesheet_tag }}
    {% render 'theme-styles' %}
    {{ content_for_header }}
  </head>
  <body class="template-password" data-page="password">
    <main id="main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
