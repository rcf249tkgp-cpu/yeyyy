{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t }} &ndash; {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap" rel="stylesheet">
    {{ 'vyro.css' | asset_url | stylesheet_tag }}
    {{ 'vyro-shopify.css' | asset_url | stylesheet_tag }}
    {% render 'theme-styles' %}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main id="main" class="acct">
      <section class="acct__gate giftcard">
        <img class="giftcard__logo" src="{{ 'vyro-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1300" height="662">
        {%- assign gc_balance = gift_card.balance | money_without_trailing_zeros -%}
        <h1 class="acct__title display">{{ 'gift_card.balance' | t: amount: gc_balance }}</h1>
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="form__error">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign gc_expiry = gift_card.expires_on | date: format: 'date' -%}
          <p class="acct__meta">{{ 'gift_card.expires' | t: date: gc_expiry }}</p>
        {%- endif -%}
        <p class="acct__lede">{{ 'gift_card.code' | t }}</p>
        <p class="giftcard__code display">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" class="giftcard__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet" loading="lazy"></a>
        {%- endif -%}
        <div class="confirm__ctas">
          <a class="btn btn--solid" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_card.shop' | t }}</a>
          <button class="btn btn--ghost" type="button" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
        </div>
      </section>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 140, height: 140 });
      });
    </script>
  </body>
</html>
