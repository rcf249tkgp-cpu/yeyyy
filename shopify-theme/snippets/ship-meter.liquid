{%- comment -%} Free-shipping progress (threshold in theme settings, store currency) {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money_without_trailing_zeros
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <p>
    {%- if remaining > 0 -%}
      {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
    {%- else -%}
      {{ 'cart.free_shipping_unlocked_html' | t }}
    {%- endif -%}
  </p>
  <div class="ship-meter__bar"><i style="width:{{ pct }}%"></i></div>
{%- endif -%}
