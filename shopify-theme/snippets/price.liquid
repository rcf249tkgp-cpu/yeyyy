{%- comment -%} Params: product or variant (object with price / compare_at_price), class {%- endcomment -%}
{%- liquid
  assign target = variant | default: product
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<span class="{{ class | default: 'price' }}{% if on_sale %} is-sale{% endif %}">
  {%- if product and variant == blank and product.price_varies -%}{{ 'products.product.from' | t }} {% endif -%}
  {{- target.price | money_without_trailing_zeros -}}
  {%- if on_sale %} <s class="price__compare">{{ target.compare_at_price | money_without_trailing_zeros }}</s>{% endif -%}
</span>
